<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    
    <!-- Truecaller SDK requires API 24, but app supports API 22. This allows SDK to work on 24+ and be disabled below -->
    <uses-sdk tools:overrideLibrary="com.truecaller.android.sdk"/>

    <!-- Internet permission for API calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Google Play Install Referrer (required for Facebook install attribution) -->
    <uses-permission android:name="com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE" />
    
    <!-- OneSignal Push Notification Permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- SMS Retriever (no SMS_READ permission needed, uses zero-permission API) -->

    <application
        android:name=".SudarNativeApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.SudarAndroidNative">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Truecaller SDK Client ID (OAuth flow) -->
        <meta-data
            android:name="com.truecaller.android.sdk.ClientId"
            android:value="@string/truecallerClientId" />
        
        <!-- Meta (Facebook) App Events SDK Configuration -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />
        <!-- Auto-log Install/Launch events -->
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="true" />
        <!-- Enable advertiser ID collection for attribution -->
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="true" />
        <!-- Auto-initialize Facebook SDK (required for install tracking) -->
        <meta-data
            android:name="com.facebook.sdk.AutoInitEnabled"
            android:value="true" />
        
        <!-- Facebook ContentProvider (REQUIRED for install tracking) -->
        <provider
            android:name="com.facebook.FacebookContentProvider"
            android:authorities="com.facebook.app.FacebookContentProvider2077952139663505"
            android:exported="false" />
        
        <!-- Facebook Activity for deferred deep linking -->
        <activity
            android:name="com.facebook.FacebookActivity"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation"
            android:exported="false" />
        
        <!-- Razorpay Subscription Payment Activity -->
        <activity
            android:name=".feature.subscription.RazorpaySubscriptionActivity"
            android:exported="false"
            android:theme="@style/Theme.SudarAndroidNative"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Install Referrer Receiver for tracking installs from Play Store -->
        <receiver
            android:name="com.facebook.CampaignTrackingReceiver"
            android:exported="true"
            android:permission="android.permission.INSTALL_PACKAGES">
            <intent-filter>
                <action android:name="com.android.vending.INSTALL_REFERRER" />
            </intent-filter>
        </receiver>

    </application>

    <!-- Required to query activities that can process text -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Truecaller package visibility for Android 11+ -->
        <package android:name="com.truecaller" />
    </queries>

</manifest>
